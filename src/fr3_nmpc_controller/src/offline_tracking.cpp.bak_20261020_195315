    check_state(initial, limits);

    fc::OptimizerConfig config;
    config.horizon = 2;
    config.dt = 0.02;
    config.max_iterations = 100;
    config.max_cpu_time_s = 5.0;
    config.max_wall_time_s = 10.0;

    for (std::size_t j = 0; j < fc::kJoints; ++j) {
      config.torque_limit[j] = limits.effort[j];

      // Illustrative offline limits; not hardware-approved settings.
      config.torque_rate_limit[j] = 200.0;
      config.acceleration_limit[j] = 2.0;
    }

    constexpr double duration = 1.0;

    // Begin with a small motion after hold mode succeeds.
    const double amplitude = mode == "hold" ? 0.0 : std::min({
      0.002,
      0.1 * (limits.upper[0] - limits.lower[0]),
      limits.velocity[0] * duration / 4.0
    });

    const std::size_t steps =
      static_cast<std::size_t>(
        std::lround(duration / config.dt));

    fc::RobotState state = initial;
    fc::JointVector previous_torque = model->gravity(initial.q);

    check_torque(previous_torque, previous_torque, config);

    // Check gravity equilibrium before invoking the optimizer.
    const auto hold_acceleration =
      model->acceleration(initial, previous_torque);

