fc::RobotState reference_at(
  double time,
  const fc::RobotState & initial,
  double amplitude,
  double duration)
{
  fc::RobotState reference = initial;

  const double s = std::clamp(time / duration, 0.0, 1.0);
  const double s2 = s * s;
  const double s3 = s2 * s;
  const double s4 = s3 * s;
  const double s5 = s4 * s;

  // Quintic position profile with zero endpoint velocity/acceleration.
  const double scale = 10.0 * s3 - 15.0 * s4 + 6.0 * s5;
  const double scale_dot =
    (30.0 * s2 - 60.0 * s3 + 30.0 * s4) / duration;

  reference.q[0] += amplitude * scale;
  reference.dq[0] = amplitude * scale_dot;

  return reference;
}

void check_state(
  const fc::RobotState & state,
  const fc::ModelLimits & limits)
{
  for (std::size_t j = 0; j < fc::kJoints; ++j) {
    if (!std::isfinite(state.q[j]) ||
        !std::isfinite(state.dq[j]))
    {
      throw std::runtime_error("Non-finite simulated state");
    }

    if (state.q[j] < limits.lower[j] ||
        state.q[j] > limits.upper[j] ||
        std::abs(state.dq[j]) > limits.velocity[j])
    {
      throw std::runtime_error(
        "Simulated state exceeds limits at joint " +
        std::to_string(j + 1));
    }
  }
}

void check_torque(
  const fc::JointVector & torque,
  const fc::JointVector & previous,
  const fc::OptimizerConfig & config)
{
  for (std::size_t j = 0; j < fc::kJoints; ++j) {
    const double tolerance = config.feasibility_tolerance;

    if (!std::isfinite(torque[j]) ||
        std::abs(torque[j]) > config.torque_limit[j] + tolerance)
    {
      throw std::runtime_error("Invalid optimized total torque");
    }

    const double maximum_change =
      config.torque_rate_limit[j] * config.dt;

    if (std::abs(torque[j] - previous[j]) >
        maximum_change + tolerance)
    {
      throw std::runtime_error("Optimized torque-rate limit exceeded");
    }
  }
}

void write_header(std::ofstream & csv)
{
  csv << "time_s,solve_ms,max_constraint_violation";

  for (std::size_t j = 1; j <= fc::kJoints; ++j) {
    csv << ",q_ref_" << j
        << ",q_" << j
        << ",dq_ref_" << j
        << ",dq_" << j
        << ",error_" << j
        << ",tau_" << j;
  }

  csv << '\n';
}

void write_sample(
  std::ofstream & csv,
  double time,
  double solve_ms,
  double violation,
  const fc::RobotState & reference,
  const fc::RobotState & state,
  const fc::JointVector & torque)
{
  csv << time << ',' << solve_ms << ',' << violation;

  for (std::size_t j = 0; j < fc::kJoints; ++j) {
    csv << ',' << reference.q[j]
        << ',' << state.q[j]
        << ',' << reference.dq[j]
        << ',' << state.dq[j]
        << ',' << reference.q[j] - state.q[j]
        << ',' << torque[j];
  }

  csv << '\n';
  csv.flush();
}

