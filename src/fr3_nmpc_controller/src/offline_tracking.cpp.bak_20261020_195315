// Smooth quintic motion: zero velocity and acceleration at both ends.
fc::RobotState reference_at(
  double time,
  const fc::RobotState & initial,
  double amplitude,
  double duration)
{
  fc::RobotState reference = initial;

  const double s = std::clamp(time / duration, 0.0, 1.0);
  const double s2 = s * s;
  const double s3 = s2 * s;
  const double s4 = s3 * s;
  const double s5 = s4 * s;

  const double position_scale = 10.0 * s3 - 15.0 * s4 + 6.0 * s5;
  const double velocity_scale =
    (30.0 * s2 - 60.0 * s3 + 30.0 * s4) / duration;

  reference.q[0] += amplitude * position_scale;
  reference.dq[0] = amplitude * velocity_scale;

  return reference;
}

void check_state(
  const fc::RobotState & state,
  const fc::ModelLimits & limits)
{
  for (std::size_t j = 0; j < fc::kJoints; ++j) {
    if (!std::isfinite(state.q[j]) || !std::isfinite(state.dq[j])) {
      throw std::runtime_error("Simulation produced non-finite state");
    }

    if (state.q[j] < limits.lower[j] ||
        state.q[j] > limits.upper[j] ||
        std::abs(state.dq[j]) > limits.velocity[j])
    {
      throw std::runtime_error("Simulated state exceeded URDF limits");
    }
  }
}

