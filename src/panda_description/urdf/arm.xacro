<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="link0_mass" value="0.1" />
    <xacro:property name="link1_mass" value="0.1" />
    <xacro:property name="link2_mass" value="0.1" />
    <xacro:property name="link3_mass" value="0.1" />
    <xacro:property name="link4_mass" value="0.1" />
    <xacro:property name="link5_mass" value="0.1" />
    <xacro:property name="link6_mass" value="0.1" />
    <xacro:property name="link7_mass" value="0.1" />
    <xacro:property name="hand_mass" value="0.1" />
    <xacro:property name="finger_mass" value="0.1" />

    <!-- World Frame -->
    <link name="world"/>

    <!-- Link 0 - Base -->
    <link name="panda_link0">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link0.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link0.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link0_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- World-Base Joint -->
    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="panda_link0"/>
        <origin xyz="0.6 0 0.35" rpy="0 0 ${pi/2.0}"/>
    </joint>

    <!-- Link 1 -->
    <link name="panda_link1">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link1.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link1.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link1_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 1 -->
    <joint name="panda_joint1" type="revolute">
        <parent link="panda_link0"/>
        <child link="panda_link1"/>
        <origin xyz="0 0 0.333" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    </joint>

    <!-- Link 2 -->
    <link name="panda_link2">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link2.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link2.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link2_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 2 -->
    <joint name="panda_joint2" type="revolute">
        <parent link="panda_link1"/>
        <child link="panda_link2"/>
        <origin rpy="-${pi/2.0} 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-1.8326" upper="1.8326" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-1.7628" soft_upper_limit="1.7628"/>
    </joint>

    <!-- Link 3 -->
    <link name="panda_link3">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link3.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link3.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link3_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 3 -->
    <joint name="panda_joint3" type="revolute">
        <parent link="panda_link2"/>
        <child link="panda_link3"/>
        <origin rpy="${pi/2.0} 0 0" xyz="0 -0.316 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    </joint>

    <!-- Link 4 -->
    <link name="panda_link4">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link4.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link4.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link4_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 4 -->
    <joint name="panda_joint4" type="revolute">
        <parent link="panda_link3"/>
        <child link="panda_link4"/>
        <origin rpy="${pi/2.0} 0 0" xyz="0.0825 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-2.9671" upper="0.105" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="0.10"/>
    </joint>

    <!-- Link 5 -->
    <link name="panda_link5">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link5.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link5.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link5_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 5 -->
    <joint name="panda_joint5" type="revolute">
        <parent link="panda_link4"/>
        <child link="panda_link5"/>
        <origin rpy="-${pi/2.0} 0 0" xyz="-0.0825 0.384 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    </joint>

    <!-- Link 6 -->
    <link name="panda_link6">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link6.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link6.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link6_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 6 -->
    <joint name="panda_joint6" type="revolute">
        <parent link="panda_link5"/>
        <child link="panda_link6"/>
        <origin rpy="${pi/2.0} 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-0.0873" upper="3.8223" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-0.0175" soft_upper_limit="3.7525"/>
    </joint>

    <!-- Link 7 -->
    <link name="panda_link7">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/link7.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/link7.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${link7_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Joint 7 -->
    <joint name="panda_joint7" type="revolute">
        <parent link="panda_link6"/>
        <child link="panda_link7"/>
        <origin rpy="${pi/2.0} 0 0" xyz="0.088 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    </joint>

    <!-- Hand Link -->
    <link name="panda_hand">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/hand.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/hand.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${hand_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Hand Joint -->
    <joint name="panda_hand_joint" type="fixed">
        <parent link="panda_link7"/>
        <child link="panda_hand"/>
        <origin rpy="0 0 0" xyz="0 0 0.106"/>
    </joint>

    <!-- Left Finger Link -->
    <link name="panda_leftfinger">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/finger.dae"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/finger.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${finger_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <gazebo reference="panda_leftfinger">
            <mu1>2.0</mu1>   <!-- 静摩擦系数 -->
            <mu2>1.5</mu2>   <!-- 动摩擦系数 -->
            <kp>1e5</kp>     <!-- 刚度（可选，提高接触刚度可减少穿透） -->
            <kd>1e3</kd>     <!-- 阻尼（可选） -->
        </gazebo>
    </link>

    <!-- Finger Joint 1 -->
    <joint name="panda_finger_joint1" type="prismatic">
        <parent link="panda_hand"/>
        <child link="panda_leftfinger"/>
        <origin rpy="0 0 0" xyz="0 0 0.0584"/>
        <axis xyz="0 1 0"/>
        <limit effort="1000.0" lower="-0.001" upper="0.05" velocity="20.0"/>
    </joint>

    <!-- Right Finger Link -->
    <link name="panda_rightfinger">
        <visual>
            <geometry>
                <mesh filename="package://panda_description/meshes/visual/finger.dae"/>
            </geometry>
            <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://panda_description/meshes/collision/finger.obj"/>
            </geometry>
            <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${finger_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <gazebo reference="panda_leftfinger">
            <mu1>2.0</mu1>   <!-- 静摩擦系数 -->
            <mu2>1.5</mu2>   <!-- 动摩擦系数 -->
            <kp>1e5</kp>     <!-- 刚度（可选，提高接触刚度可减少穿透） -->
            <kd>1e3</kd>     <!-- 阻尼（可选） -->
        </gazebo>
    </link>

    <!-- Finger Joint 2 -->
    <joint name="panda_finger_joint2" type="prismatic">
        <parent link="panda_hand"/>
        <child link="panda_rightfinger"/>
        <origin rpy="0 0 0" xyz="0 0 0.0584"/>
        <axis xyz="0 1 0"/>
        <limit effort="1000.0" lower="-0.05" upper="0.001" velocity="20.0"/>
        <mimic joint="panda_finger_joint1" multiplier="-1"/>
    </joint>

</robot>