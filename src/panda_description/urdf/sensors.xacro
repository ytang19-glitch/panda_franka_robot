<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.1" />
    <xacro:property name="camera_width" value="0.1" />
    <xacro:property name="camera_height" value="0.05" />
    <xacro:property name="camera_mass" value="0.1" />

    <!-- Camera Link -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
                <!-- <mesh filename="package://panda_description/meshes/visual/camera.dae"/> -->
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
                <!-- <mesh filename="package://panda_description/meshes/collision/camera.obj"/> -->
            </geometry>
            <material name="red"/>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="${camera_mass}"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Base-Camera Joint -->
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.6 0 1.0" rpy="0.0 0.0 0.0"/>
        <parent link="panda_link0"/>
        <child link="camera_link"/>
    </joint>

    <!-- Camera Optical Link -->
    <link name="camera_link_optical" />
    
    <!-- Camera-Optical Joint -->  <!--to fit opencv orientation-->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/> 
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 ${pi/2.0} 0</pose>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <always_on>1</always_on>
            <topic>camera/image_raw</topic>
            <!-- Camera Intrinsics -->
            <camera name="intel_realsense_r200">
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <optical_frame_id>camera_link_optical</optical_frame_id>
                <horizontal_fov>1.0</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>320</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>